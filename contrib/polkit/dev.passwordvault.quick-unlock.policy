<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!--
  Quick unlock for Secret Vault on Linux (vaultd/src/polkit.rs).

  vaultd asks polkit about this action when you quick-unlock a vault it
  locked. Your desktop's polkit agent asks for your login password, or a
  fingerprint or face where PAM offers one (fprintd, Howdy). The answer is
  never kept, so every quick unlock asks again; vaultd refuses quick unlock
  if a local rule allows this action without asking.

  The packages and get.sh install it, through vault-setup-user. By hand,
  for a vaultd that runs as you: sudo install -m644 contrib/polkit/dev.passwordvault.quick-unlock.policy /usr/share/polkit-1/actions/
-->
<policyconfig>
  <vendor>Secret Vault</vendor>
  <action id="dev.passwordvault.quick-unlock">
    <description>Quick unlock Secret Vault</description>
    <message>Confirm it's you to unlock Secret Vault again</message>
    <icon_name>dev.passwordvault.app</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_self</allow_active>
    </defaults>
    <!-- vaultd@you runs as its own account, vault-you, and asks on your
         behalf; vault-setup-user lists every such account here when it
         installs this file into /usr/share/polkit-1/actions. -->
    <annotate key="org.freedesktop.policykit.owner">unix-user:vault</annotate>
  </action>
</policyconfig>
