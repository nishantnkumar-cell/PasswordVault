<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Launch agent: starts vaultd when you sign in and restarts it if it stops.
  install.sh writes it to ~/Library/LaunchAgents/ with VAULTD set to the
  vaultd inside Secret Vault.app, and loads it with
      launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/dev.passwordvault.vaultd.plist
  It runs in your desktop session (Aqua), which the approval window and
  Touch ID need.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.passwordvault.vaultd</string>
    <key>ProgramArguments</key>
    <array>
        <string>VAULTD</string>
    </array>
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ProcessType</key>
    <string>Interactive</string>
    <!-- Keys must never reach a core dump. -->
    <key>SoftResourceLimits</key>
    <dict>
        <key>Core</key>
        <integer>0</integer>
    </dict>
    <key>HardResourceLimits</key>
    <dict>
        <key>Core</key>
        <integer>0</integer>
    </dict>
    <key>StandardErrorPath</key>
    <string>LOG</string>
</dict>
</plist>
