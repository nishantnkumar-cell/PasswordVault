<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Launch agent installed by SecretVault-<version>-macos.pkg in
  /Library/LaunchAgents: starts vaultd in each account's desktop session
  (Aqua, which the approval window and Touch ID need) at sign-in, and
  restarts it if it stops. Same label as the per-user agent install.sh
  writes (contrib/macos/dev.passwordvault.vaultd.plist); the .pkg removes
  that one, so only one is ever loaded.

  A shared agent cannot name a per-user log file, so a shell opens
  ~/Library/Logs/vaultd.log and then becomes vaultd.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.passwordvault.vaultd</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>mkdir -p "$HOME/Library/Logs" &amp;&amp; exec "/Applications/Secret Vault.app/Contents/MacOS/vaultd" 2&gt;&gt;"$HOME/Library/Logs/vaultd.log"</string>
    </array>
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ProcessType</key>
    <string>Interactive</string>
    <!-- Keys must never reach a core dump. -->
    <key>SoftResourceLimits</key>
    <dict>
        <key>Core</key>
        <integer>0</integer>
    </dict>
    <key>HardResourceLimits</key>
    <dict>
        <key>Core</key>
        <integer>0</integer>
    </dict>
</dict>
</plist>
