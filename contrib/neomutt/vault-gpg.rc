# NeoMutt and Mutt: sign, encrypt and decrypt mail with OpenPGP keys held in
# the vault, through vault-gpg. Based on the gpg.rc sample that ships with
# NeoMutt, with gpg replaced by vault-gpg and passphrase options removed (the
# vault asks for approval instead).
#
# Use: source this file from your muttrc and set pgp_default_key.
# pgpewrap is at /usr/libexec/neomutt/pgpewrap on Debian and Ubuntu,
# /usr/lib/neomutt/pgpewrap or /usr/lib/mutt/pgpewrap elsewhere: adjust the
# two encrypt commands below.

set crypt_use_gpgme = no
set pgp_check_gpg_decrypt_status_fd
set pgp_good_sign = "^\\[GNUPG:\\] GOODSIG"
set pgp_decryption_okay = "^\\[GNUPG:\\] DECRYPTION_OKAY"

set pgp_decode_command = "vault-gpg --status-fd=2 --no-verbose --quiet --batch --output - %f"
set pgp_verify_command = "vault-gpg --status-fd=2 --no-verbose --quiet --batch --output - --verify %s %f"
set pgp_decrypt_command = "vault-gpg --status-fd=2 --no-verbose --quiet --batch --output - --decrypt %f"
set pgp_sign_command = "vault-gpg --no-verbose --batch --quiet --output - --armor --textmode %?a?--local-user %a? --detach-sign %f"
set pgp_encrypt_only_command = "/usr/libexec/neomutt/pgpewrap vault-gpg --batch --quiet --no-verbose --output - --textmode --armor --encrypt -- --recipient %r -- %f"
set pgp_encrypt_sign_command = "/usr/libexec/neomutt/pgpewrap vault-gpg --batch --quiet --no-verbose --textmode --output - %?a?--local-user %a? --armor --sign --encrypt -- --recipient %r -- %f"
set pgp_import_command = "vault-gpg --no-verbose --import %f"
set pgp_export_command = "vault-gpg --no-verbose --armor --export %r"
set pgp_verify_key_command = "vault-gpg --verbose --batch --fingerprint --check-sigs %r"
set pgp_list_pubring_command = "vault-gpg --no-verbose --batch --quiet --with-colons --with-fingerprint --list-keys %r"
set pgp_list_secring_command = "vault-gpg --no-verbose --batch --quiet --with-colons --with-fingerprint --list-secret-keys %r"
# Clear-signed (inline) messages are not supported by vault-gpg.
unset pgp_clear_sign_command
