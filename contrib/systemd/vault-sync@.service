# Cloud sync helper (docs/cloud-sync.md) for the system service vaultd@.service:
# runs as the same account, vault-<you>, and mirrors the cloud mailbox to
# /var/lib/vault/<you>/cloud, the folder vaultd@<you> keeps in sync.
#
#   sudo install -m755 target/release/vault-sync /usr/local/bin/
#   sudo install -m644 contrib/systemd/vault-sync@.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now vault-sync@$USER
#
# It holds only the encrypted vault file and this device's access token,
# never a key, and is the only Secret Vault program that uses the network.

[Unit]
Description=Secret Vault cloud sync helper for %i
Wants=network-online.target
After=network-online.target vaultd@%i.service

[Service]
User=vault-%i
Group=vault-%i
ExecStart=/usr/local/bin/vault-sync --dir /var/lib/vault/%i/cloud
Restart=on-failure
RestartSec=10
LimitCORE=0
NoNewPrivileges=yes
CapabilityBoundingSet=
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
UMask=0077
# Only the cloud folder is writable, and vaultd's state (paired clients)
# is hidden, so a fault in this network-facing program cannot pair a client
# or touch the vault file, although it runs as the same account as vaultd. The
# folder exists once `vault cloud setup` or `vault cloud join` ran; start
# this unit after that.
ReadWritePaths=-/var/lib/vault/%i/cloud
InaccessiblePaths=-/var/lib/vault/%i/state

[Install]
WantedBy=multi-user.target
