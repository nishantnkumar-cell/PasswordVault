# Cloud sync helper (docs/cloud-sync.md), for the per-user vaultd.service.
# Install next to vaultd.service in ~/.config/systemd/user/, then, after
# `vault cloud setup` or `vault cloud join`:
#   systemctl --user daemon-reload && systemctl --user enable --now vault-sync
#
# It mirrors the cloud mailbox to ~/.local/share/vault/cloud, the folder
# vaultd keeps in sync. It holds only the encrypted vault file and this
# device's access token, never a key, and is the only Secret Vault program
# that uses the network.

[Unit]
Description=Secret Vault cloud sync helper
Wants=network-online.target
After=network-online.target vaultd.service

[Service]
ExecStart=%h/.cargo/bin/vault-sync
Restart=on-failure
RestartSec=10
LimitCORE=0
NoNewPrivileges=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
PrivateTmp=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
UMask=0077
# Only the cloud folder is writable, and vaultd's state (paired clients)
# is hidden, so a fault in this network-facing program cannot pair a client
# or touch the vault file. The folder exists once `vault cloud setup` or
# `vault cloud join` ran; start this unit after that.
ReadWritePaths=-%h/.local/share/vault/cloud
InaccessiblePaths=-%h/.local/state/vault -%h/.config/vault

[Install]
WantedBy=default.target
