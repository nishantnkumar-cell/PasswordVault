# User service: install to ~/.config/systemd/user/ and run
#   systemctl --user daemon-reload && systemctl --user enable --now vaultd
# This runs vaultd as you. vaultd@.service runs it as a separate system user,
# which also protects its memory from other programs running as you.
#
# The pairing approval window (vault-prompt) runs as a child of this unit and
# needs DISPLAY or WAYLAND_DISPLAY; desktop sessions import those into the
# user manager. That is also why MemoryDenyWriteExecute is off here: OpenGL
# drivers that compile code at run time (llvmpipe) need it.

[Unit]
Description=Secret Vault daemon

[Service]
ExecStart=%h/.cargo/bin/vaultd
Restart=on-failure
# Keys must never reach swap or a core dump.
LimitCORE=0
LimitMEMLOCK=infinity
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
PrivateTmp=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths=%h/.local/share/vault %h/.local/state/vault %t/vault
# FIDO2 keys (hidraw) and the TPM resource manager.
DeviceAllow=/dev/tpmrm0 rw
DeviceAllow=char-hidraw rw

[Install]
WantedBy=default.target
