# System service: vaultd runs as its own system account for each person,
# vault-<login>, so processes running as you cannot read its memory (threat
# model A3), and one person's vaultd cannot reach another's. One instance per
# person; the instance name is your login name. The .deb, the Arch package
# and get.sh set it up; by hand:
#
#   sudo install -m644 contrib/sysusers.d/vault.conf /etc/sysusers.d/ && sudo systemd-sysusers
#   sudo install -m644 contrib/udev/70-vault-fido.rules /etc/udev/rules.d/ && sudo udevadm control --reload && sudo udevadm trigger
#   sudo install -m755 target/release/vaultd /usr/local/bin/
#   sudo install -m644 contrib/systemd/vaultd@.service /etc/systemd/system/
#   sudo install -Dm644 contrib/polkit/dev.passwordvault.quick-unlock.policy /usr/local/share/secret-vault/
#   sudo install -m755 contrib/linux/vault-setup-user /usr/local/sbin/
#   sudo vault-setup-user enable $USER
#
# Clients find the socket, /run/vault/<login>/vaultd.sock, by themselves.

[Unit]
Description=Secret Vault daemon for %i
After=systemd-logind.service

[Service]
User=vault-%i
Group=vault-%i
# vault: FIDO2 keys (given to group vault by the udev rule). tss: /dev/tpmrm0.
SupplementaryGroups=vault tss
ExecStart=/usr/local/bin/vaultd --owner-user %i --vault /var/lib/vault/%i/vault.svault --state-dir /var/lib/vault/%i/state --socket /run/vault/%i/vaultd.sock
StateDirectory=vault/%i
StateDirectoryMode=0700
RuntimeDirectory=vault/%i
RuntimeDirectoryMode=0755
Restart=on-failure
LimitCORE=0
LimitMEMLOCK=infinity
NoNewPrivileges=yes
CapabilityBoundingSet=
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service @memlock
PrivateTmp=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
UMask=0077
DevicePolicy=closed
DeviceAllow=/dev/tpmrm0 rw
DeviceAllow=char-hidraw rw

[Install]
WantedBy=multi-user.target
