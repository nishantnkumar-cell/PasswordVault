{
  "manifest_version": 3,
  "name": "Secret Vault",
  "version": "0.1.0",
  "description": "Fills logins from your local Secret Vault.",
  "permissions": ["nativeMessaging", "activeTab", "scripting", "webNavigation"],
  "background": { "service_worker": "background.js", "scripts": ["background.js"], "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Secret Vault" },
  "commands": {
    "fill-login": {
      "suggested_key": { "default": "Ctrl+Shift+L" },
      "description": "Fill the only matching login on this page"
    }
  },
  "browser_specific_settings": { "gecko": { "id": "autofill@passwordvault.dev", "strict_min_version": "128.0" } }
}
